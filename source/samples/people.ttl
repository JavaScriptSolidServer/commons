# Three made-up people and who knows whom.
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .

<#alice> a foaf:Person ;
    foaf:name "Alice Example" ;
    foaf:mbox <mailto:alice@example.org> ;
    foaf:knows <#bob>, <#carol> .

<#bob> a foaf:Person ;
    foaf:name "Bob Example" ;
    schema:jobTitle "Gardener" ;
    foaf:knows <#alice> .

<#carol> a foaf:Person ;
    foaf:name "Carol Example" ;
    schema:homeLocation "Lisbon" .
