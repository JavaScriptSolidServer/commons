{
  "@context": { "solid": "http://www.w3.org/ns/solid/terms#" },
  "@graph": [
    { "@id": "", "@type": ["solid:TypeIndex", "solid:UnlistedDocument"] },
    { "@id": "#notes", "@type": "solid:TypeRegistration",
      "solid:forClass": { "@id": "http://www.w3.org/ns/iana/media-types/text/markdown#Resource" },
