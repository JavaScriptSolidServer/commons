<#Iss1> a t:Doing ; wf:tracker t:this ; dc:title "Level the base" ;
    wf:description "The slabs at the back corner sit about 2 cm low. Lift them, add sand, check with the long level. Then put the bearers down and screw them to the slabs so nothing shifts in a frost." ;
    dct:created "2026-09-03T10:00:00Z"^^xsd:dateTime ; dc:author <https://alice.example/profile/card#me> ;
    wf:assignee <https://bob.example/profile/card#me> .
