@prefix meeting: <http://www.w3.org/ns/pim/meeting#> .
@prefix cal: <http://www.w3.org/2002/12/cal/ical#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix wf: <http://www.w3.org/2005/01/wf/flow#> .
@prefix ui: <http://www.w3.org/ns/ui#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A sample with made-up people, in the format SolidOS's meeting pane writes. Read-only here.
# The times are exact moments (UTC); the pane shows them in the viewer's own time zone.
<#this> a meeting:Meeting ;
    cal:summary "Planning the spring workshop" ;
    cal:dtstart "2026-12-03T14:00:00Z"^^xsd:dateTime ;
    cal:dtend "2026-12-03T15:30:00Z"^^xsd:dateTime ;
    cal:location "Room 2, Example Hall, and on video for those who cannot come" ;
    cal:comment "Agree the dates and the three talks.\nBring ideas for a venue." ;
    dc:author <https://alice.example/profile/card#me> ;
    dc:created "2026-11-20T09:12:00Z"^^xsd:dateTime ;
    ui:backgroundColor "#ddddcc"^^xsd:color ;
    meeting:toolList ( <#this> <#id1> <#id2> <#id3> <#id4> ) ;
    meeting:chat <Chat/chat.ttl> ;
    meeting:sharedNotes <SharedNotes/index.ttl#this> ;
    wf:attachment <https://workshop.example.org/agenda>, <https://workshop.example.org/last-year-report.pdf> ;
    wf:participation <#p1>, <#p2>, <#p3> .

<#id1> a meeting:Tool ; rdfs:label "Agenda" ; meeting:target <https://workshop.example.org/agenda> ; meeting:view "iframe" .
<#id2> a meeting:Tool ; rdfs:label "Shared notes" ; meeting:target <SharedNotes/index.ttl#this> .
<#id3> a meeting:Tool ; rdfs:label "Chat" ; meeting:target <Chat/chat.ttl> .
<#id4> a meeting:Tool ; rdfs:label "Last year's report" ; meeting:target <https://workshop.example.org/last-year-report.pdf> ; meeting:view "iframe" .

<#p1> wf:participant <https://alice.example/profile/card#me> ; cal:dtstart "2026-11-20T09:12:00Z"^^xsd:dateTime .
<#p2> wf:participant <https://bob.example/profile/card#me> ; cal:dtstart "2026-11-20T10:01:00Z"^^xsd:dateTime .
<#p3> wf:participant <https://carol.example/profile/card#me> ; cal:dtstart "2026-11-20T11:30:00Z"^^xsd:dateTime .

# Names as SolidOS keeps them beside a group's members, so the sample reads well without the profiles.
<https://alice.example/profile/card#me> vcard:fn "Alice" .
<https://bob.example/profile/card#me> vcard:fn "Bob" .
<https://carol.example/profile/card#me> vcard:fn "Carol" .
