@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<../index.ttl#this> vcard:includesGroup <#this> .
<#this> a vcard:Group ; vcard:fn "Friends" ;
    vcard:hasMember <../Person/alice/index.ttl#this>, <https://carol.example.org/profile/card#me> .
<../Person/alice/index.ttl#this> vcard:fn "Alice Example" .
<https://carol.example.org/profile/card#me> <http://www.w3.org/2002/07/owl#sameAs> <../Person/carol/index.ttl#this> .
<../Person/carol/index.ttl#this> vcard:fn "Carol Danvers" .
