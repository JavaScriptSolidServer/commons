{
  "@context": { "acl": "http://www.w3.org/ns/auth/acl#", "foaf": "http://xmlns.com/foaf/0.1/" },
  "@graph": [
    { "@id": "#alice", "@type": "acl:Authorization",
      "acl:agent": { "@id": "https://alice.example/profile/card#me" },
      "acl:accessTo": { "@id": "./" }, "acl:default": { "@id": "./" },
      "acl:mode": [ { "@id": "acl:Read" }, { "@id": "acl:Write" }, { "@id": "acl:Control" } ] },
    { "@id": "#bob", "@type": "acl:Authorization",
      "acl:agent": { "@id": "https://bob.example/profile/card#me" },
      "acl:accessTo": { "@id": "./" }, "acl:default": { "@id": "./" },
      "acl:mode": [ { "@id": "acl:Read" }, { "@id": "acl:Write" } ] },
    { "@id": "#carol", "@type": "acl:Authorization",
      "acl:agent": { "@id": "https://carol.example/profile/card#me" },
      "acl:accessTo": { "@id": "./" },
      "acl:mode": [ { "@id": "acl:Read" } ] },
    { "@id": "#loggedin", "@type": "acl:Authorization",
      "acl:agentClass": { "@id": "acl:AuthenticatedAgent" },
      "acl:accessTo": { "@id": "./" }, "acl:default": { "@id": "./" },
      "acl:mode": [ { "@id": "acl:Read" }, { "@id": "acl:Append" } ] },
    { "@id": "#friends", "@type": "acl:Authorization",
      "acl:agentGroup": { "@id": "https://alice.example/groups/friends#group" },
      "acl:accessTo": { "@id": "./" }, "acl:default": { "@id": "./" },
      "acl:mode": [ { "@id": "acl:Read" } ] },
    { "@id": "#app", "@type": "acl:Authorization",
      "acl:agent": { "@id": "https://alice.example/profile/card#me" },
      "acl:origin": { "@id": "https://notes.example" },
      "acl:accessTo": { "@id": "./" }, "acl:default": { "@id": "./" },
      "acl:mode": [ { "@id": "acl:Read" }, { "@id": "acl:Write" } ] }
  ]
}
