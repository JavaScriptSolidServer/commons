    schema:aggregateRating 4.6 ; schema:bookFormat schema:EBook ;
    schema:dateRead "2026-09-19T22:00:00Z"^^xsd:dateTime .
<#b12> a schema:Book ; schema:name "Iron and Willow" ; schema:author <#carol> ; schema:datePublished "2025-11-11"^^xsd:date ;
    schema:numberOfPages 1200 ; schema:genre "History" ; schema:inLanguage "en" ; schema:publisher "Harbour Books" ;
    schema:aggregateRating 4.2 ; schema:isbn "978-0-00-000012-7" ; schema:bookFormat schema:Hardcover ;
