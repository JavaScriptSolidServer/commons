    schema:dateRead "2026-05-30T21:45:00Z"^^xsd:dateTime .
<#b8> a schema:Book ; schema:name "Counting the Tide" ; schema:author <#bob> ; schema:datePublished "2020-08-08"^^xsd:date ;
