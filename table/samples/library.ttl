    schema:aggregateRating 3.9 ; schema:isbn "978-0-00-000008-0" ; schema:bookFormat schema:EBook ;
    schema:dateRead "2026-06-14T17:20:00Z"^^xsd:dateTime .
<#b9> a schema:Book ; schema:name "Paper Lanterns" ; schema:author <#carol> ; schema:datePublished "2018-12-24"^^xsd:date ;
    schema:numberOfPages 150 ; schema:genre "Poetry", "Fiction" ; schema:inLanguage "en" ; schema:publisher "Example Press" ;
    schema:aggregateRating 4.3 ; schema:bookFormat schema:Paperback .
<#b10> a schema:Book ; schema:name "The Long Way Round the Lake" ; schema:author <#alice> ; schema:datePublished "2022-03-03"^^xsd:date ;
